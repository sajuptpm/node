# Configuration template for coverage-windows.yml

# Repository Secrets (Optional - only required for uploading coverage to external Codecov service)
CODECOV_TOKEN=""               # Codecov repository upload token

# Repository Variables (Optional)
RUNNER_LABEL="windows-2025"    # Runner pool label (defaults to windows-2025 or windows-latest)
ENABLE_COVERAGE_WINDOWS="false"# Set to "true" to enable full build on push on forks

# Workflow Dispatch Inputs (Optional defaults)
INPUT_TEST_SCOPE="smoke"       # smoke: fast toolchain & sample coverage; full: complete vcbuild build
INPUT_MODE="auto"              # auto | native | original
