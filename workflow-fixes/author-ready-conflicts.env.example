# Environment configuration template for author-ready-conflicts.yml
# Mode resolution: auto (default), native (audit summary/artifact), original (live unlabel & comment)

# [Optional] Custom runner label (defaults to ubuntu-latest)
# RUNNER_LABEL=ubuntu-latest

# [Optional] Global workflow mode override (auto | native | original)
# WORKFLOW_MODE=auto

# [Optional] Enable scheduled conflicts scanning on forks (default: false unless sajuptpm owner)
# ENABLE_UNLABEL_CONFLICTS=true

# [Optional] Upstream bot token for PR mutation in original mode
# GH_USER_TOKEN=ghp_exampleTokenWithRepoAndWorkflowScopes
