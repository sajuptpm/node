# ==============================================================================
# Environment Configuration Template for create-release-proposal.yml
# Copy to create-release-proposal.env for local development and reference.
# ==============================================================================

# --- Secrets (Optional in Native Mode) ---
# GitHub Personal Access Token for upstream bot account (nodejs-github-bot)
# When omitted, the workflow automatically falls back to $GITHUB_TOKEN with contents:write and pull-requests:write.
GH_USER_TOKEN=

# --- Repository Variables (Optional) ---
# Runner label expression (defaults to ubuntu-latest if unset)
RUNNER_LABEL=ubuntu-latest

# Global execution mode override: auto | native | original
WORKFLOW_MODE=auto

# Release line to prepare proposal for (e.g., 22)
RELEASE_LINE=22

# Scheduled release date (YYYY-MM-DD format)
RELEASE_DATE=2026-11-02

# Dry-run flag: simulate release prepare locally without remote git mutations
DRY_RUN=true

# Node.js runtime version
NODE_VERSION=lts/*
