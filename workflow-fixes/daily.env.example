# Configuration template for daily.yml (Node.js daily job)

# Repository Variables (Actions > Settings > Variables > Actions)
# Runner label (default: ubuntu-latest; upstream used ubuntu-24.04-arm)
RUNNER_LABEL=ubuntu-latest

# Enable scheduled daily runs on forks (default: false)
ENABLE_DAILY_BUILD=false

# Workflow Dispatch Inputs
# build_scope: smoke | full (default: smoke)
BUILD_SCOPE=smoke

# mode: auto | native | original (default: auto)
MODE=auto
