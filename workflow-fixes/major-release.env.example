# Repository Variables
RUNNER_LABEL=ubuntu-latest
ENABLE_MAJOR_RELEASE=false
CREATE_MAJOR_RELEASE_ISSUE=false

# Workflow Dispatch Inputs
INPUT_FORCE_RUN=true
