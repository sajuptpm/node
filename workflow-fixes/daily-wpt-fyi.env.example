# ==============================================================================
# Environment Configuration Template for daily-wpt-fyi.yml
# Copy to daily-wpt-fyi.env for local development and reference.
# ==============================================================================

# --- Secrets (Optional in Native Mode) ---
# Password for wpt.fyi results upload API
WPT_FYI_PASSWORD=

# --- Repository Variables (Optional) ---
# Username for wpt.fyi results upload API
WPT_FYI_USERNAME=

# Runner label expression (defaults to ubuntu-latest if unset)
RUNNER_LABEL=ubuntu-latest

# Global execution mode override: auto | native | original
WORKFLOW_MODE=auto

# Targeted Node.js version line (e.g., 22, 20, latest-nightly, or all)
NODE_VERSION_INPUT=22

# Smoke test dry-run flag to avoid rebuilding Node.js from C++ source
DRY_RUN=true
