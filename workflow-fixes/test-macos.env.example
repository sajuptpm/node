# Environment configuration template for test-macos.yml
# Mode resolution: auto (default), native (smoke test), original (full 2-hour build)

# [Optional] Custom macOS runner label (defaults to macos-latest)
# MAC_RUNNER_LABEL=macos-latest

# [Optional] Global workflow mode override (auto | native | original)
# WORKFLOW_MODE=auto

# [Optional] Enable heavy automatic push test runs on forks (default: false to conserve minutes)
# ENABLE_MACOS_TESTS=true
