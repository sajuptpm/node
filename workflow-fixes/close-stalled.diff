+          echo "| :--- | :--- | :--- | :--- | :--- |" >> close-stalled-report.md
+
+          issues=$(gh issue list --repo "$GITHUB_REPOSITORY" --label "stalled" --state open --limit 20 --json number,title,updatedAt 2>/dev/null || echo "[]")
+          issue_count=$(echo "$issues" | jq '. | length' 2>/dev/null || echo 0)
