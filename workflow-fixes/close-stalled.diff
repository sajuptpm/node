+        default: 100
+        type: number
 
 env:
   CLOSE_MESSAGE: >
@@ -14,23 +41,119 @@ permissions:
 
 jobs:
   stale:
+    name: Process Stalled Issues & PRs
     permissions:
       issues: write  # for actions/stale to close stale issues
       pull-requests: write  # for actions/stale to close stale PRs
-    if: github.repository == 'nodejs/node'
