+          prs=$(gh pr list --repo "$GITHUB_REPOSITORY" --label "stalled" --state open --limit 20 --json number,title,updatedAt 2>/dev/null || echo "[]")
+          pr_count=$(echo "$prs" | jq '. | length' 2>/dev/null || echo 0)
+          if [ "$pr_count" -gt 0 ]; then
+            echo "$prs" | jq -r '.[] | "| #\(.number) | \(.title | gsub("[\\|\n]"; " ")) | open | \(.updatedAt) | Would Close (Dry-Run) |"' >> close-stalled-report.md
+          else
