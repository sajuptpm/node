+      dry_run:
+        description: 'Audit stalled issues and PRs without actually closing them'
+        required: false
+        default: true
+        type: boolean
+      days_before_close:
+        description: 'Days before closing stalled items'
+        required: false
+        default: 30
+        type: number
+      operations_per_run:
+        description: 'Max API operations per run'
