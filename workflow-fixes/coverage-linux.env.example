# Configuration template for coverage-linux.yml

# Repository Secrets (Optional - only required for uploading coverage to external Codecov service)
CODECOV_TOKEN=""               # Codecov repository upload token

# Repository Variables (Optional)
RUNNER_LABEL="ubuntu-24.04"    # Runner pool label (defaults to ubuntu-24.04)
ENABLE_COVERAGE_LINUX="false"  # Set to "true" to enable full build on push on forks

# Workflow Dispatch Inputs (Optional defaults)
INPUT_TEST_SCOPE="smoke"       # smoke: fast toolchain & sample coverage; full: complete make test-cov build
INPUT_MODE="auto"              # auto | native | original
