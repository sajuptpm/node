# Environment and Repository Variables for codeql.yml

# Execution Mode: auto | native | original
# - auto: automatically uses selected language and smoke test
# - native: fast GitHub-native CodeQL analysis on selected language
# - original: full CodeQL matrix scan over cpp, javascript, and python
CODEQL_MODE=auto

# Language to analyze: javascript | python | cpp | all (default: javascript)
CODEQL_LANGUAGE=javascript

# Smoke test toggle: true | false
CODEQL_SMOKE_TEST=true

# Enable scheduled runs on non-upstream forks (default: false)
ENABLE_CODEQL=false

# Runner label override (default: ubuntu-latest)
RUNNER_LABEL=ubuntu-latest
