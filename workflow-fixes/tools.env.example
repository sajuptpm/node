# Environment configuration template for tools.yml
# Mode resolution: auto (default), native, original

# [Optional] Custom runner label (defaults to ubuntu-latest)
# RUNNER_LABEL=ubuntu-latest

# [Optional] Global workflow mode override (auto | native | original)
# WORKFLOW_MODE=auto

# [Optional] Enable scheduled tools/deps updates on forks (default: false unless sajuptpm owner)
# ENABLE_TOOLS_UPDATE=true

# [Optional] Upstream bot token for opening pull requests in original mode
# GH_USER_TOKEN=ghp_exampleTokenWithRepoAndWorkflowScopes
