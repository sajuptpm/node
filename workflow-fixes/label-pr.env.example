# ==============================================================================
# Environment Configuration Template for label-pr.yml
# Copy to label-pr.env for local development and reference.
# ==============================================================================

# --- Secrets (Optional in Native Mode) ---
# GitHub Personal Access Token for upstream bot account (nodejs-github-bot)
# When omitted, the workflow automatically falls back to standard $GITHUB_TOKEN with pull-requests:write.
GH_USER_TOKEN=

# --- Repository Variables (Optional) ---
# Runner label expression (defaults to ubuntu-latest if unset)
RUNNER_LABEL=ubuntu-latest

# Global execution mode override: auto | native | original
WORKFLOW_MODE=auto

# Target PR number for dispatch testing
PR_NUMBER=1

# Dry-run flag for label testing without modifying PR metadata
DRY_RUN=false
