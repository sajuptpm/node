# Environment and Repository Variables for build-tarball.yml

# Execution Mode: auto | native | original
# - auto: native in workflow_dispatch, original when enabled
# - native: fast source archive packaging, extraction verification, and structure check
# - original: full make tar, Clang installation, and make build-ci on arm/linux
TARBALL_MODE=auto

# Smoke test toggle: true | false
TARBALL_SMOKE_TEST=true

# Enable heavy tarball build on fork push to main/staging (default: false)
ENABLE_TARBALL_BUILDS=false

# Python version (default: 3.12)
PYTHON_VERSION=3.12

# Runner overrides
RUNNER_LABEL=ubuntu-latest
ARM_RUNNER=ubuntu-latest
