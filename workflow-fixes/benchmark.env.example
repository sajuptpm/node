# Environment and Repository Variables for benchmark.yml

# Execution Mode: auto | native | original
# - auto: automatically uses native smoke test unless overridden
# - native: fast GitHub-native smoke benchmark execution without Nix or compilation
# - original: full Nix / Cachix double compilation and Rscript aggregation
BENCHMARK_MODE=auto

# Smoke test toggle: true | false
# When true, runs lightweight benchmark verification using runner node runtime
BENCHMARK_SMOKE_TEST=true

# Category of benchmark to run (e.g. misc, buffers, cluster)
BENCHMARK_CATEGORY=misc

# Substring filter for benchmarks in category
BENCHMARK_FILTER=arguments

# Number of iterations to repeat benchmark (default: 1)
BENCHMARK_RUNS=1

# Enable full 4-platform matrix in original mode (default: false)
# Requires arm Linux and macOS runners
ENABLE_FULL_BENCHMARK_MATRIX=false

# Runner label overrides
RUNNER_LABEL=ubuntu-latest
LINUX_RUNNER=ubuntu-24.04
ARM_RUNNER=ubuntu-24.04
MAC_INTEL_RUNNER=macos-13
MAC_ARM_RUNNER=macos-latest

# Secrets (Optional for cross-repo comments)
# COMMENT_TOKEN=ghp_your_github_token
