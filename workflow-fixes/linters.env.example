# Configuration template for linters.yml (Linters)

# Repository Variables (Actions > Settings > Variables > Actions)
# Runner label (default: ubuntu-latest; upstream used ubuntu-slim)
RUNNER_LABEL=ubuntu-latest

# Enable full linter execution on pushes in forks (default: false)
ENABLE_LINTERS=false

# Repository Secrets (optional, only needed for GitHub bot org teams in lint-readme)
GH_USER_TOKEN=

# Workflow Dispatch Inputs
# test_scope: smoke | full (default: smoke)
TEST_SCOPE=smoke

# mode: auto | native | original (default: auto)
MODE=auto
