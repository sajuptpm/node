# Configuration template for label-flaky-test-issue.yml (Label Flaky Test Issues)

# Repository Variables (Actions > Settings > Variables > Actions)
# Runner label (default: ubuntu-latest; upstream used ubuntu-slim)
RUNNER_LABEL=ubuntu-latest

# Workflow Dispatch Inputs
# issue_number: string (optional, e.g. 1)
ISSUE_NUMBER=

# issue_body: sample issue body for testing label extraction
ISSUE_BODY=Platform\n\nLinux x64, macOS ARM64, Windows\n\nOther details

# apply_labels: true | false (default: false)
APPLY_LABELS=false

# mode: auto | native | original (default: auto)
MODE=auto
