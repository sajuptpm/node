# Environment and Repository Variables for comment-labeled.yml

# Execution Mode: auto | native | original
# - auto: native (dry_run) in workflow_dispatch, original when dry_run=false
# - native: safe simulation generating comment preview and report artifact without remote mutation
# - original: live comment posting to GitHub Issues/PRs via gh CLI
COMMENT_LABELED_MODE=auto

# Dry-run toggle: true | false
# When true, formats and previews comments without posting to GitHub
COMMENT_LABELED_DRY_RUN=true

# Label triggered: all | stalled | fast-track | notable-change (default: all)
COMMENT_LABEL=all

# Target issue or PR number to test (default: 1)
COMMENT_TARGET_NUMBER=1

# Enable webhook execution on non-upstream forks (default: false)
ENABLE_COMMENT_LABELED=false

# Runner label override (default: ubuntu-latest)
RUNNER_LABEL=ubuntu-latest
