# Environment and Repository Variables for close-stalled.yml

# Execution Mode: auto | native | original
# - auto: native (dry_run) in workflow_dispatch, original when dry_run=false
# - native: dry-run audit with debug-only: true and step summary report
# - original: live issue/PR closure via actions/stale
CLOSE_STALLED_MODE=auto

# Dry-run toggle: true | false
# When true, scans and audits stalled items without closing them
CLOSE_STALLED_DRY_RUN=true

# Days before closing stalled items (default: 30)
DAYS_BEFORE_CLOSE=30

# Max operations per run (default: 100)
OPERATIONS_PER_RUN=100

# Enable scheduled runs on non-upstream forks (default: false)
ENABLE_CLOSE_STALLED=false

# Runner label override (default: ubuntu-latest)
RUNNER_LABEL=ubuntu-latest
