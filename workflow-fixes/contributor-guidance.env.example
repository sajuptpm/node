# Configuration template for contributor-guidance.yml

# Repository Secrets (Optional - only needed for privileged author association checks in Original Mode)
GH_USER_TOKEN=""               # GitHub PAT with repository permissions for privileged author association lookup

# Repository Variables (Optional)
RUNNER_LABEL="ubuntu-latest"   # Runner pool label (defaults to ubuntu-latest)
ENABLE_CONTRIBUTOR_GUIDANCE="false" # Set to "true" to force evaluation on forks

# Workflow Dispatch Inputs (Optional defaults)
INPUT_PR_NUMBER="1"            # Pull Request number to test/evaluate
INPUT_IS_FIRST_TIME="true"     # Simulate first-time contributor (true/false)
INPUT_SIMULATE_CAUTION="false" # Simulate AgentScan caution advisory flag (true/false)
INPUT_DRY_RUN="true"           # true: preview/simulate comments; false: post comment live to PR
INPUT_MODE="auto"              # auto | native | original
