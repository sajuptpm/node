# ==============================================================================
# Environment Configuration Template for commit-lint.yml
# Copy to commit-lint.env for local development and reference.
# ==============================================================================

# --- Repository Variables (Optional) ---
# Runner label expression (defaults to ubuntu-latest if unset)
RUNNER_LABEL=ubuntu-latest

# Global execution mode override: auto | native | original
WORKFLOW_MODE=auto

# Pull request number to evaluate when running manual dispatch
PR_NUMBER=1

# Optional test commit message string (for debugging lint rules directly)
COMMIT_MESSAGE=

# Enforce hard failure on validation issues: true | false (default: false in native mode)
FAIL_ON_INVALID_COMMIT=false

# Node.js runtime version
NODE_VERSION=lts/*
