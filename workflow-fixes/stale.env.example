# ==============================================================================
# Environment Configuration for .github/workflows/stale.yml
# ==============================================================================

# Repository Variables
RUNNER_LABEL=ubuntu-latest
ENABLE_STALE=false

# Workflow Dispatch Inputs
INPUT_DRY_RUN=true
INPUT_DAYS_BEFORE_STALE=90
INPUT_DAYS_BEFORE_CLOSE=30
INPUT_MODE=native
