# Configuration template for find-inactive-tsc.yml (Find inactive TSC voting members)

# Repository Variables (Actions > Settings > Variables > Actions)
# Runner label (default: ubuntu-latest; upstream used ubuntu-slim)
RUNNER_LABEL=ubuntu-latest

# Enable scheduled runs on forks (default: false)
ENABLE_INACTIVE_TSC=false

# Repository Secrets (optional, only needed for automated PR creation in Original Mode)
GH_USER_TOKEN=

# Workflow Dispatch Inputs
# create_pr: true | false (default: false)
CREATE_PR=false

# mode: auto | native | original (default: auto)
MODE=auto
