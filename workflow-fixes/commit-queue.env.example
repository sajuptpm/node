# Configuration template for commit-queue.yml

# Repository Secrets (Optional - only required for Original Mode with Jenkins CI & automated push landing)
JENKINS_USER=""        # Jenkins username authorized to query CI job metadata
JENKINS_TOKEN=""       # Jenkins API token for the Jenkins user
GH_USER_TOKEN=""       # GitHub Personal Access Token (classic with repo or fine-grained with contents:write, pull-requests:write)

# Repository Variables (Optional)
RUNNER_LABEL="ubuntu-latest"  # Runner pool label (defaults to ubuntu-latest)
ENABLE_COMMIT_QUEUE="false"   # Set to "true" to enable scheduled cron runs on a fork

# Workflow Dispatch Inputs (Optional defaults)
INPUT_CANDIDATES=""    # Space-separated list of PR numbers to evaluate (e.g. "123 456")
INPUT_DRY_RUN="true"   # true: simulate check & landing without modifying PRs; false: live landing
INPUT_MODE="auto"      # auto | native | original
