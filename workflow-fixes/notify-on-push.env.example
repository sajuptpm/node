# ==============================================================================
# Environment Configuration Template for notify-on-push.yml
# Copy to notify-on-push.env for local development and reference.
# ==============================================================================

# --- Secrets (Optional in Native Mode) ---
# Incoming Webhook URL for Slack channel notifications
# When omitted, the workflow automatically selects Native Mode (GitHub Step Summary & Artifacts).
SLACK_WEBHOOK=

# --- Repository Variables (Optional) ---
# Runner label expression (defaults to ubuntu-latest if unset)
RUNNER_LABEL=ubuntu-latest

# Global execution mode override: auto | native | original
WORKFLOW_MODE=auto

# Enforce hard failure on commit validation errors: true | false (default: false in native mode)
FAIL_ON_INVALID_COMMIT=false

# Node.js runtime version
NODE_VERSION=lts/*
