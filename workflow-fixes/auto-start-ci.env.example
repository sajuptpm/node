# Environment and Repository Variables for auto-start-ci.yml

# Execution Mode: auto | native | original
# - auto: automatically use Jenkins if JENKINS_TOKEN and JENKINS_USER are provided, else native
# - native: GitHub-native CLI PR evaluation and audit report without calling external Jenkins
# - original: Upstream Jenkins CI dispatch via ncu-ci and start-ci.sh
AUTO_START_CI_MODE=auto

# Dry-run mode: true | false
# When true, scans and evaluates PR mergeability and labels without mutating or calling Jenkins
AUTO_START_CI_DRY_RUN=true

# Space-separated PR numbers to test/audit (leave empty to scan open repository PRs)
AUTO_START_CI_PR_NUMBERS=1

# Maximum PRs to process per run (default: 5)
AUTO_START_CI_BATCH_SIZE=5

# Maximum running/queued Jenkins workload threshold (default: 15)
AUTO_START_CI_MAX_WORKLOAD=15

# Enable auto-start-ci in non-upstream forks for scheduled runs
ENABLE_AUTO_START_CI=false

# Runner label override (default: ubuntu-latest)
RUNNER_LABEL=ubuntu-latest

# Secrets (Only required for 'original' mode)
# JENKINS_USER=your-jenkins-username
# JENKINS_TOKEN=your-jenkins-api-token
# GH_TOKEN=ghp_your_github_token
