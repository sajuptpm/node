# Environment configuration template for test-shared.yml
# Mode resolution: auto (default), native (smoke validation), original (full multi-platform matrix build)

# [Optional] Custom runner label for x86_64 Linux jobs (defaults to ubuntu-latest)
# RUNNER_LABEL=ubuntu-latest

# [Optional] Custom runner label for aarch64 Linux jobs (defaults to ubuntu-24.04-arm)
# ARM_RUNNER_LABEL=ubuntu-24.04-arm

# [Optional] Global workflow mode override (auto | native | original)
# WORKFLOW_MODE=auto

# [Optional] Enable heavy automatic push test runs on forks (default: false to conserve minutes)
# ENABLE_SHARED_TESTS=true

# [Optional] Cachix auth token for write access to nodejs.cachix.org
# CACHIX_AUTH_TOKEN=cachix_token_example
