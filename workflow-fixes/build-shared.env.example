# Environment and Repository Variables for build-shared.yml

# Execution Mode: auto | native | original
# - auto: native in workflow_dispatch, original when called by full suite
# - native: fast GitHub-native smoke validation of Nix configurations and flags
# - original: full Nix / Cachix double build and test execution from tarball
SHARED_BUILD_MODE=auto

# Smoke test toggle: true | false
SHARED_BUILD_SMOKE_TEST=true

# Runner override (default: ubuntu-latest)
RUNNER_LABEL=ubuntu-latest

# Optional Secrets (for original Cachix binary cache access)
# CACHIX_AUTH_TOKEN=your-cachix-token
