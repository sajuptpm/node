+          branch: actions/tools-update-openssl
           commit-message: 'deps: update archs files for openssl-${{ env.NEW_VERSION }}'
           path: deps/openssl
+
+      - name: Native OpenSSL Version Audit & Sanity Check
+        if: inputs.mode != 'original' || inputs.dry_run == true
+        shell: bash
+        env:
+          GITHUB_TOKEN: ${{ secrets.GH_USER_TOKEN || secrets.GITHUB_TOKEN }}
+        run: |
+          mkdir -p reports
+          echo "Executing native OpenSSL version audit..."
+
+          VERSION_H="./deps/openssl/config/archs/linux-x86_64/asm/include/openssl/opensslv.h"
+          CURRENT_VERSION=$(grep "OPENSSL_FULL_VERSION_STR" "$VERSION_H" | sed -n 's/^.*VERSION_STR "\(.*\)"/\1/p' || echo "unknown")
+          echo "Vendored OpenSSL Version: $CURRENT_VERSION"
+
+          # Query GitHub API for latest OpenSSL 3.5 tag
+          AUTH_HEADER=()
+          if [ -n "$GITHUB_TOKEN" ]; then
+            AUTH_HEADER=(-H "Authorization: Bearer $GITHUB_TOKEN")
+          fi
+
+          LATEST_TAG=$(curl -s "${AUTH_HEADER[@]}" -H "User-Agent: node-ci" \
+            https://api.github.com/repos/openssl/openssl/git/matching-refs/tags/openssl-3.5 \
+            | grep '"ref":' | tail -1 | sed -n 's/.*"refs\/tags\/\(.*\)".*/\1/p' || echo "openssl-3.5.x")
+
+          LATEST_VERSION=$(echo "$LATEST_TAG" | sed 's/openssl-//;s/-/+/g')
+          echo "Upstream Latest OpenSSL Tag: $LATEST_TAG (version: $LATEST_VERSION)"
+
+          # Verify updater script existence
+          test -x tools/dep_updaters/update-openssl.sh && echo "tools/dep_updaters/update-openssl.sh is executable"
+
+          cat <<EOF > reports/openssl-update-report.md
+          # OpenSSL Update Audit Report
+
+          - **Runner OS**: \`${{ runner.os }}\`
+          - **Trigger**: \`${{ github.event_name }}\`
+          - **Mode**: \`${{ inputs.mode || 'auto' }}\`
+          - **Dry Run**: \`${{ inputs.dry_run || 'true' }}\`
+          - **Vendored OpenSSL Version**: \`$CURRENT_VERSION\`
+          - **Latest Available OpenSSL Release**: \`$LATEST_VERSION\` (\`$LATEST_TAG\`)
+          - **Updater Script**: \`tools/dep_updaters/update-openssl.sh\` verified
+          - **Status**: Audit completed successfully.
+          EOF
+
+          echo "## OpenSSL Update Summary" >> "$GITHUB_STEP_SUMMARY"
+          echo "" >> "$GITHUB_STEP_SUMMARY"
+          cat reports/openssl-update-report.md >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Upload OpenSSL Report Artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: openssl-update-report
+          path: reports/openssl-update-report.md
+          if-no-files-found: ignore
